{# Shared asset card: keep titles visible and actions separate from the preview. #}
{% if content %}
<article{{ attributes.addClass('dam-media-card') }}>
  <a class="dam-media-card__preview" href="{{ view_url }}" aria-label="{{ 'View asset'|t }}: {{ media.label }}">
    {{ content.thumbnail }}
  </a>
  <div class="dam-media-card__body">
    <h3 class="dam-media-card__title"><a href="{{ view_url }}">{{ content.name }}</a></h3>
    <div class="dam-media-card__meta">{{ content.field_category }}{{ content.field_template_category }}{{ content.field_field_category }}</div>
    {% if edit_link or delete_link %}
      <div class="dam-media-card__actions">{{ edit_link }}{{ delete_link }}</div>
    {% endif %}
  </div>
</article>
{% endif %}
